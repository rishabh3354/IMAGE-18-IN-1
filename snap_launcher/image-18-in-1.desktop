[Desktop Entry]
Version=1.0
Type=Application
Name=Image 18-in-1
GenericName=Image Tools
Comment=Compress, resize, convert, upscale and edit images offline
Icon=image-18-in-1
Exec=image-18-in-1 %F
Terminal=false
Categories=Graphics;Photography;Qt;
MimeType=image/jpeg;image/png;image/gif;image/webp;image/bmp;image/tiff;image/svg+xml;image/heic;image/heif;image/avif;
Keywords=image;photo;compress image;resize image;crop;convert to jpg;heic to jpg;upscale;remove background;blur face;watermark;meme;exif;
StartupWMClass=image18in1
